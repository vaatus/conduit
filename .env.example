# SPDX-License-Identifier: MIT
# ─── Gemini cloud (set real value in .env) ─────────────────────
GEMINI_API_KEY=                                  # from aistudio.google.com

# ─── Lobster Trap configuration ────────────────────────────────
# Backend talks to LT for prompt inspection AND uses LT as the OpenAI base_url proxy to Gemini.
LT_INSPECT_URL=http://lobster-trap:8000/_lobstertrap/inspect
LT_GEMINI_BASE_URL=http://lobster-trap:8000/v1/   # backend's OpenAI client points HERE, NEVER at Gemini directly
LT_POLICY_PATH=/policies/policy.yaml

# In-process mock toggle for `lobstertrap` when the proxy isn't available.
# Default off in prod; enabled in docker-compose dev profile so the demo runs without the LT binary.
LT_MOCK_MODE=false

# ─── Gemini models ─────────────────────────────────────────────
GEMINI_MODEL_CLASSIFY=gemini-2.5-flash
GEMINI_MODEL_SANITIZE=gemini-2.5-pro
GEMINI_MODEL_NARRATIVE=gemini-2.5-pro

# ─── Backend ───────────────────────────────────────────────────
DB_PATH=./data/events.db
BACKEND_PORT=8001
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000

# ─── Dashboard ─────────────────────────────────────────────────
NEXT_PUBLIC_API=http://localhost:8001

# ─── MCP server (Model Context Protocol) ───────────────────────
# Exposes Conduit's audit + policy surface to AI agents (Claude Desktop,
# internal copilots, Slack bots). HTTP for remote, stdio for local.
CONDUIT_BACKEND_URL=http://localhost:8001
MCP_TRANSPORT=stdio                # 'stdio' | 'http' | 'sse'
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765
MCP_AUTH_TOKEN=                    # empty disables; set in prod
